datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum StockStatus {
  IN_STOCK
  PRE_ORDER
  SERVICE_ONLY
}

enum BookingStatus {
  PENDING_DEPOSIT
  PENDING_ERP_SYNC
  DEPOSIT_PAID_ERP_SYNCED
  IN_WORKSHOP
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  PROMPTPAY_QR
  CREDIT_CARD
}

model User {
  id           String                @id @default(uuid())
  email        String                @unique
  phone        String?               @unique
  passwordHash String?
  name         String?
  taxId        String?
  erpCustomerId String?              @unique
  role         Role                  @default(CUSTOMER)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  vehicles     CustomerVehicle[]
  bookings     ServiceBooking[]
  warranties   WarrantyCertificate[]
}

model CustomerVehicle {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  licensePlate String           @unique
  make         String
  model        String
  submodel     String?
  year         String
  vin          String?
  lastMileage  Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  bookings     ServiceBooking[]
}

model CatalogProduct {
  id                 String            @id
  sku                String            @unique
  name               String
  category           String
  brand              String
  image              String
  partPrice          Float
  laborPrice         Float
  installHours       Int               @default(2)
  stockStatus        StockStatus       @default(IN_STOCK)
  stockQty           Int               @default(0)
  leadTimeDays       Int               @default(0)
  compatibleVehicles String[]
  specs              String[]
  warrantyMonths     Int               @default(12)
  warrantyKm         Int               @default(20000)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  bookingItems       BookingLineItem[]
}

model ShowcaseBuild {
  id            String   @id
  title         String
  vehicleId     String
  vehicleLabel  String
  categoryTag   String
  heroImage     String
  galleryImages String[]
  ownerHandle   String
  completedDate String
  summary       String
  suspensionSpec String
  wheelsSpec    String
  brakesSpec    String
  exhaustSpec   String
  partIds       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceBooking {
  id                String            @id @default(uuid())
  bookingNo         String            @unique
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId         String?
  vehicle           CustomerVehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerName      String
  customerPhone     String
  licensePlate      String
  vehicleLabel      String
  appointmentDate   String
  appointmentSlot   String
  bayAssigned       String
  partsReadiness    String
  repairStage       Int               @default(1)
  partsTotal        Float
  laborTotal        Float
  grandTotal        Float
  depositPaid       Float
  remainingBalance  Float
  paymentMethod     PaymentMethod     @default(PROMPTPAY_QR)
  paymentGatewayRef String?           @unique
  holdToken         String?
  retryCount        Int               @default(0)
  lastSyncAttempt   DateTime?
  lastSyncError     String?
  warrantiesIssued  Int               @default(0)
  status            BookingStatus     @default(DEPOSIT_PAID_ERP_SYNCED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             BookingLineItem[]
  webhookLogs       ErpWebhookLog[]
}

model BookingLineItem {
  id          String         @id @default(uuid())
  bookingId   String
  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId   String?
  product     CatalogProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku         String
  name        String
  partPrice   Float
  laborPrice  Float
  stockStatus StockStatus
}

model WarrantyCertificate {
  id            String   @id @default(uuid())
  certNo        String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productName   String
  sku           String
  serialOrDot   String
  licensePlate  String
  vehicleLabel  String
  installedDate String
  expiryDate    String
  installedKm   Int
  maxWarrantyKm Int
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}

model ErpWebhookLog {
  id          String         @id @default(uuid())
  bookingId   String
  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  endpointUrl String
  event       String
  payloadJson String
  httpStatus  Int            @default(200)
  createdAt   DateTime       @default(now())
}
